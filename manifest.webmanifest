{
  "name": "G-Code Simulator",
  "short_name": "G-Code Sim",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "background_color": "#1b2430",
  "theme_color": "#1b2430",
  "description": "Offline G-code simulator for milling, turning, drilling and 5-axis programs.",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "file_handlers": [
    {
      "action": "./index.html",
      "accept": {
        "text/plain": [
          ".nc",
          ".mpf",
          ".eia",
          ".tap",
          ".gcode",
          ".cnc",
          ".ngc",
          ".txt"
        ]
      }
    }
  ]
}